        {"id": "volumeSlider", "type": "slider", "label": "Volume", "description": "Sets the playback level", "group": "playback", "properties": {"min": 0, "max": 1, "default": 0.5, "step": 0.01, "showValue": false}},
        {
          "id": "rangeSelect",
          "type": "dropdown",
          "label": "Range",
